 fun copy ( name : String = this . name , age : Int = this . age ) = 
 copy ( name = name , age = age ) \/\/ Calls the function below.],
  [fun copy ( name : String = this . name , nickname : String ? = this . nickname , age : Int = this . age ) = 
 Person ( name , nickname , age ) 
 }],
