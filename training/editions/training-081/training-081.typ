  [require "benchmark/ips" 
 
 def allocations 
 x = GC . stat( :total\_allocated\_objects )
 yield 
 GC . stat( :total\_allocated\_objects ) - x
 end 
 
 def go doc
 lexer = Lexer . new doc
 while tok = lexer . next\_token
 end 
 end 
 
 doc = ARGF . read
 
 Benchmark . ips \{ | x | x . report \{ go doc \} \}
 p ALLOCATIONS : allocations \{ go doc \}
 p ALLOCATIONS : allocations \{ go doc \}],
