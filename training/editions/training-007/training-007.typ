 👩 👪 👮 👯 👺 👻 👼 👽 👾 👿 💀 💁 💂 💃 💄 💅 );],
  [while (\<\>) {
 if (/[a-f0-9:]+:[a-f0-9:]+/) {
 (\$b, \$m, \$a) = (\$\`, \$&, \$');
