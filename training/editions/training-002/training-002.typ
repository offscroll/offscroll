  title: [\#692: Q&A: My Brother-in-Law Wants to Buy a Rental in Mexico. Good Idea?],
  kicker: [Cover Story],
  author: [Paula Pant],
  source-name: [Afford Anything],
  deck: [class="smart-track-player-container stp-color-ff5252-EEEEEE spp-stp-desktop"\>

