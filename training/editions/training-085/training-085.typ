 while self . current\_char is not None and self . current\_char . isdigit (): 
 result += self . current\_char 
 self . advance () 
 return int ( result )],
  [def get\_next\_token ( self ): 
 """Lexical analyzer (also known as scanner or tokenizer)],
  [This method is responsible for breaking a sentence 
