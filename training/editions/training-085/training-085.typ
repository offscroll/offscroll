  [def visit\_BinOp ( self , node ): 
 if node . op . type == PLUS : 
 return self . visit ( node . left ) + self . visit ( node . right ) 
 elif node . op . type == MINUS : 
 return self . visit ( node . left ) - self . visit ( node . right ) 
 elif node . op . type == MUL : 
 return self . visit ( node . left ) \* self . visit ( node . right ) 
 elif node . op . type == DIV : 
 return self . visit ( node . left ) \/ self . visit ( node . right )],
