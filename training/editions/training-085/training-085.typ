 """Advance the \`pos\` pointer and set the \`current\_char\` variable.""" 
 self . pos += 1 
 if self . pos \> len ( self . text ) - 1 : 
 self . current\_char = None \# Indicates end of input 
 else : 
 self . current\_char = self . text \[ self . pos \]],
