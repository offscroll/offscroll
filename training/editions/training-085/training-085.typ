 \#include 
 
 int main () \{ 
 std :: filesystem :: path dir = "/abc/cde" ; \/\\/ recursive?
 std :: error\_code ec \{\}; 
 if ( std :: filesystem :: create\_directory ( dir , ec )) 
 std :: cout Failed to create directory: No such file or directory
 ...],
