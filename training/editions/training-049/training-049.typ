  title: [Optimising LINQ],
  kicker: [Cover Story],
  author: [Matt Warren (.NET)],
  source-name: [Matt Warren (.NET)],
  deck: [Where ( new Func ( CS \<\> 8 \_\_locals0 . b\_\_0 )) 
